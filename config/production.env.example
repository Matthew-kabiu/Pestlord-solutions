# Copy to .env.production. Keep real secrets out of version control.
NODE_ENV=production
APP_IMAGE=ghcr.io/matthew-kabiu/pestlord-solutions
PESTLORD_VERSION=1.0.0
APP_HOST=127.0.0.1
APP_PORT=3012
WEB_PORT=5173
API_PORT=3012
BIND_HOST=0.0.0.0
HEALTHCHECK_HOST=127.0.0.1
API_UPSTREAM_HOST=api
SITE_URL=
SITE_INDEXABLE=true
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=
N8N_BOOKING_WEBHOOK_URL=
N8N_QUOTE_WEBHOOK_URL=
BODY_LIMIT_BYTES=16384
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=25000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
LOG_LEVEL=info
API_DOCS_ENABLED=false
