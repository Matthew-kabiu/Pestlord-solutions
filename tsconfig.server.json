{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "seo/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
