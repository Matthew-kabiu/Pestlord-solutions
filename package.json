{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --mode development",
    "dev:api": "tsx watch server/server.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node build/server/server.js",
    "test": "vitest run",
    "check:client": "tsx scripts/check-client.ts",
    "check:workflows": "tsx scripts/check-workflows.ts",
    "env:validate": "tsx scripts/validate-env.ts",
    "compose:dev": "tsx scripts/compose.ts development",
    "compose:prod": "tsx scripts/compose.ts production",
    "lint": "eslint .",
    "preview": "tsx --env-file=.env.production server/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.server.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.13",
    "lucide-react": "^0.344.0",
    "pino": "10.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@eslint/js": "^9.9.1",
    "@types/node": "24.19.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.1.12",
    "vitest": "3.2.7"
  }
}
